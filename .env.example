# --- Database ---
POSTGRES_USER=resume_matcher
POSTGRES_PASSWORD=resume_matcher
POSTGRES_DB=resume_matcher
POSTGRES_PORT=5432
# Used by the backend directly; must match the POSTGRES_* values above.
DATABASE_URL=postgresql+asyncpg://resume_matcher:resume_matcher@localhost:5432/resume_matcher

# --- Backend ---
BACKEND_PORT=8000
ENVIRONMENT=development

# --- NLP (wired up in Phase 3) ---
SPACY_MODEL=en_core_web_sm

# --- Embeddings (wired up in Phase 6) ---
EMBEDDING_MODEL_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# --- LLM (wired up in Phase 12) ---
# LLM_PROVIDER: anthropic | openai | local (local = Ollama, no API key needed)
LLM_PROVIDER=anthropic
LLM_API_KEY=
# LLM_MODEL: optional — defaults per provider (see app/services/llm_service.py)
LLM_MODEL=
OLLAMA_BASE_URL=http://localhost:11434

# --- API (wired up in Phase 8) ---
UPLOAD_DIR=./data/uploads

# --- ML training/evaluation (wired up in Phase 11) ---
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=resume_job_matching
